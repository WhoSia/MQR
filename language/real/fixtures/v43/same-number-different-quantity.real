REALREPRESENT 0.43-CANDIDATE
id numeric_alias_is_not_quantity_identity
basis FINITE_COUNTERMODEL
target physical_state
source channel_A
destination channel_B
quantity_source DOSE
quantity_destination TIME
unit_source Gy
unit_destination Gy
operation_source SAME
